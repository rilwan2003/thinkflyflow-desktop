{
  "name": "thinkflyflow-desktop",
  "version": "0.1.0",
  "description": "ThinkFlyFlow Desktop: sync local folders with your workspace",
  "main": "dist-electron/electron/main.js",
  "author": "ThinkFlyFlow",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "start": "npm run build:electron && electron dist-electron/electron/main.js",
    "test": "npm run build:electron && node --test test/engine.node.test.js",
    "test:watch": "node --test --watch test/",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "dist": "npm run build && electron-builder",
    "smoke": "npm run build && TFF_SMOKE=1 xvfb-run -a electron --no-sandbox dist-electron/electron/main.js",
    "smoke:search": "npm run build && TFF_SMOKE=1 xvfb-run -a electron --no-sandbox dist-electron/scripts/searchSmoke.js",
    "verify": "npm run test && npm run smoke && npm run smoke:search && node scripts/packageCheck.js",
    "package:check": "npm run build && node scripts/packageCheck.js",
    "dev:app": "npm run build:electron && TFF_DEV_SERVER=1 electron dist-electron/electron/main.js"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^38.8.6",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "build": {
    "appId": "com.thinkflyflow.desktop",
    "productName": "ThinkFlyFlow",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "**/*.png"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "rilwan2003",
        "repo": "thinkflyflow-desktop"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rilwan2003/thinkflyflow-desktop.git"
  }
}